# Copy this file to API.env (or .env) and fill in the keys you use.
# These values are backend-only and are never exposed to the browser.

# Anthropic (optional) - enables Claude models.
ANTHROPIC_API_KEY=

# Google Gemini (optional) - enables the built-in Gemini models.
# Add any number of keys: GEMINI_API_KEY, GEMINI_API_KEY_2, GEMINI_API_KEY_3, ...
# Keys are read only by the backend and are never returned to the browser.
# Note: keys in the same Google Cloud project share one quota pool. PHOTON does not rotate
# keys to bypass quota or billing limits.
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# Optional Gemini model filters (centrally control what the selector offers).
# Comma-separated exact IDs, or prefix globs such as gemini-2.5-*
# GEMINI_MODEL_ALLOW=
# GEMINI_MODEL_DENY=gemini-1.5-*

# OpenRouter (optional) - enables OpenRouter free models in Quick Settings.
# Supports up to 10 keys: OPENROUTER_API_KEY (slot 1), then OPENROUTER_API_KEY_2 ... _10.
# Keys are validated with a real API request; merely existing in this file is not enough.
# Get keys at https://openrouter.ai/keys. PHOTON never exposes them to the browser.
# Multiple keys on the same OpenRouter account share one credit balance and rate limit;
# PHOTON does not rotate keys to get around a 429 or a billing limit.
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=
# OPENROUTER_API_KEY_4=
# OPENROUTER_API_KEY_5=
# OPENROUTER_API_KEY_6=
# OPENROUTER_API_KEY_7=
# OPENROUTER_API_KEY_8=
# OPENROUTER_API_KEY_9=
# OPENROUTER_API_KEY_10=

# Optional OpenRouter overrides (normally leave these unset).
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:3001

# OpenAI GPT (optional) - enables GPT models after an administrator verifies them.
# One backend-only key. It is never sent to the browser or written to logs.
# ChatGPT subscriptions do not provide API credit; API billing must be enabled separately.
# Models are discovered from GET /v1/models and stay disabled until verified in the admin panel.
OPENAI_API_KEY=
# Optional OpenAI overrides (normally leave these unset).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated exact IDs or prefix globs such as gpt-5-*
# OPENAI_MODEL_ALLOW=
# OPENAI_MODEL_DENY=

# CodeCraft API (optional) - OpenAI-compatible AI gateway with free allowance.
# One backend-only key. Never sent to the browser or written to logs.
# Get your key at: https://codecraftapi.com/dashboard/api-keys
# Models are discovered from GET /v1/models. Provider must be enabled in the admin panel.
# Default spending policy is 'block' (zero-billing safe). Change to 'allow_free_only' in admin.
CODECRAFT_API_KEY=
# CODECRAFT_API_BASE=https://www.codecraftapi.com/v1

# GroqCloud API (optional) - Ultra-fast Llama 3, Mixtral, and open models.
# One backend-only key. Never sent to the browser or written to logs.
# Get your free key at: https://console.groq.com/keys
# Models are discovered from GET /openai/v1/models.
GROQ_API_KEY=
# GROQ_API_BASE=https://api.groq.com/openai/v1

# Local Ollama (optional) - free local fallback, e.g. Gemma.
# No API key is used. Models are read from GET /api/tags at runtime.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set OLLAMA_ENABLED=0 to turn the local adapter off completely.
# OLLAMA_ENABLED=1

# Server
PORT=3001
NODE_ENV=development

# Admin panel (set a real password outside local development).
PHOTON_ADMIN_EMAIL=admin@just4madam.com
PHOTON_ADMIN_PASSWORD=
